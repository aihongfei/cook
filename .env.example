# Docker Compose 环境变量（复制为 .env 后按需修改；.env 不入库、不写进文档与对话）
#
# 部署到服务器前务必替换成强密码。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=cook
MYSQL_USER=cook
MYSQL_PASSWORD=change_me
# 宿主机映射端口（本机 3306 被占用时可改）
MYSQL_PORT=3306
# 映射到宿主机的**绑定地址**（默认值与不设时完全一致）。本机开发留 0.0.0.0 即可；
# **部署到公网服务器时改成 127.0.0.1** —— 否则安全组一放开就是公网裸库。
# 容器之间走 compose 网络互访，不受这个绑定影响。
MYSQL_BIND=0.0.0.0

# ---- 服务端口 ----
# 只有后端、MySQL 与 MinIO 进 Docker（前端本机跑 Vite，打包走 Capacitor 出 APK），所以没有 WEB_PORT
API_PORT=3000
# 绑定地址：服务器上保持 0.0.0.0（前端与 APK 都要访问）；将来放到反向代理后面才改 127.0.0.1
API_BIND=0.0.0.0

# ---- 菜谱图片自托管（MinIO）----
# 图片从第三方 API 导入时是对方图床直链（会过期），导入后由 `pnpm run mirror:images`
# 备份进 MinIO 的 cook-media 桶，此后前端只读自己的图。
MINIO_ROOT_USER=change_me_minio
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 绑定地址：**9000 必须公网可达**（接口返回的图片地址指到这里）；
# **控制台 9001 部署时改成 127.0.0.1** —— 没人需要从公网进控制台
MINIO_BIND=0.0.0.0
MINIO_CONSOLE_BIND=0.0.0.0
MEDIA_S3_BUCKET=cook-media
# 接口返回图片时拼的对外前缀：**必须是浏览器能访问到的地址**，部署到服务器时要改成域名或公网 IP。
MEDIA_BASE_URL=http://127.0.0.1:9000/cook-media

# ---- 其它 ----
TZ=Asia/Shanghai
# 国内网络下构建很慢时可换成 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org/
# Alpine 软件源（**构建期**用，不是运行时变量）。国内服务器直连官方站拉不到 APKINDEX，
# 构建报 "no such package: ca-certificates" / "curl" 时改成 https://mirrors.aliyun.com/alpine
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
# 允许访问接口的前端来源（逗号分隔）。三个来源各有来由，少一个就有一端打不开：
# - 本机 Vite 开发服务器（浏览器调试）
# - 同端口换 localhost 写法
# - **APK 里的 WebView**：`androidScheme: 'http'`（apps/mobile/capacitor.config.ts）让它挂在
#   `http://localhost`，Origin 就长这样。不放行则 APK 里所有请求被 CORS 拦，
#   页面能打开但数据全空（实测报错：No 'Access-Control-Allow-Origin' header is present）
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://localhost

# ---- 登录令牌签名密钥（F2-02）----
# 至少 32 个字符；生成方式：openssl rand -base64 48
# 故意留空：留空或过短时后端**直接启动失败**。不要填占位值——否则会用一个人人都可见的密钥签令牌。
JWT_SECRET=

# ---- 找回密码的邮件发送（F2-04）----
# console（默认）：邮件内容写进服务端日志，**仅供开发**；此时接口会把重置链接一并返回，方便本地联调。
# smtp：真发信，需要下面的 MAIL_SMTP_*；**部署到公网前必须切到 smtp**（见 RISKS R-16）。
MAIL_TRANSPORT=console
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
# 重置链接里用的前端地址（开发期是本机 Vite；部署时改成正式域名）
PUBLIC_APP_URL=http://127.0.0.1:5173

# ---- AI 推荐与问答（M16 子集 / D-026）----
# 一个 OpenAI 兼容的对话模型（POST {base}/chat/completions）。
# 填了才启用；留空则前端的 AI 入口显示"去配置"，其余功能照常。
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
# 可选：单次调用超时（毫秒，默认 90000，上限 120000）
AI_TIMEOUT_MS=
# 可选：结构化输出（response_format = json_schema + strict），**默认开**。
# 实测 DeepSeek 走本网关时 json_schema 正常工作（回包形状确定，比在提示词里求它更稳）；
# 上游不认 response_format 时会回 4xx，那时把这个填 0。
AI_JSON_SCHEMA=

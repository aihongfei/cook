# 依赖与产物
node_modules/
dist/
build/
out/
*.tsbuildinfo

# 发出去的安装包（单包 19MB 的二进制，不该进版本库；可随时从源码重建）
# 这里放的是给人拿的副本，源产物在 apps/mobile/android/app/build/outputs/apk/ 下
release/
*.apk

# 环境与密钥（绝不入库）
.env
.env.local
.env.*.local
!.env.example

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# AI 助手的工作状态（计划草稿等本机产物）：不进版本库
.zcode/

# 日志
*.log
npm-debug.log*
yarn-error.log*

# 数据库（开发期 SQLite）
*.db
*.db-journal
services/api/prisma/*.db

# 图片生成的中间产物（原图与重试件，单张 1~3MB）
# 真正进应用的成品在 apps/mobile/public/img/corner/，是压缩过的 256~384px PNG
generated-images/

# 测试与覆盖率
coverage/
test-results/
playwright-report/
.test-build/

# 第三方参考截图（仅本地对照，不入库）
参考图片/

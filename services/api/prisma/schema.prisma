// 开发期 SQLite，生产切 PostgreSQL（见 docs/context/PLAN.md 技术路线）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 键值型元信息，M0 用来验证 Prisma 迁移与读写链路可用
model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// JSON collections retain ordered ingredients, nested step text and source notes.
/// origin and sourceKey isolate imported records from future user-created recipes.
model Recipe {
  id                String   @id
  name              String
  image             String?
  category          String
  cuisine           String
  aliases           Json
  tags              Json
  calories          Float?
  caloriesEstimated Boolean  @default(false)
  spiciness         Int      @default(0)
  ingredients       Json
  steps             Json
  notes             Json
  tools             Json
  videoUrl          String?
  source            Json
  origin            String   @default("user")
  sourceKey         String?  @unique
  sourcePath        String?
  rawMarkdown       String?
  searchText        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, cuisine])
  @@index([origin])
}

// 数据库：MySQL 8（本地与服务器统一走 Docker，见 docker-compose.yml）。历史 SQLite 迁移已归档到 history/。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 键值型元信息，M0 用来验证 Prisma 迁移与读写链路可用
model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// 账号（F2-01/02/03）：账号 + 密码登录，未登录不可使用（D-008）。
/// 密码只存 scrypt 派生结果，格式 `scrypt$N$r$p$salt$hash`（自描述，便于日后换参数或算法）。
/// 口味/忌口档案（M8）与家庭成员关系（F2-05）后续都挂在这个 id 上。
model User {
  id                 String              @id @default(cuid())
  account            String              @unique @db.VarChar(64)
  nickname           String              @db.VarChar(32)
  /// emoji 头像（与手绘风一致，见 apps/mobile 的 me__avatar）
  avatar             String              @default("🐰") @db.VarChar(16)
  passwordHash       String              @db.VarChar(255)
  /// 找回密码用的邮箱。首版**不做验证**（不要求收信确认），只作为重置链接的收件地址。
  email              String?             @unique @db.VarChar(160)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  /// 首版一个账号同时只属于一个家庭（DB 层用唯一约束兜住，见 FamilyMember）
  membership         FamilyMember?
  /// 这个账号点过的菜（M3）
  orderItems         OrderItem[]
  /// 这个账号的打卡照片（M9 / F9-07）
  checkIns           CheckIn[]
  /// 这个账号组过的常用组合（M4 / F4-04）
  combos             Combo[]
  /// 这个账号定下来的餐（M4 / F4-05 的确认留痕）
  confirmedMeals     MealOrder[]
  /// 这个账号标成「做好了」的餐（M10 / F10-02）
  doneMeals          MealOrder[]         @relation("MealDoneBy")
  /// 这个账号的消息提醒开关与已读位置（M10 / F10-04）
  notificationPref   NotificationPref?
  /// 这个账号的通知历史（M10 的事件日志）
  notificationEvents NotificationEvent[]
  /// 这个账号收藏的菜（M1 / F1-09）
  favorites          Favorite[]
  /// 这个账号放进冰箱的食材（M6 / F6-01）
  fridgeItems        FridgeItem[]
  /// 这个账号让 AI 干过的写库动作（F16-10 / AI 助手）——撤销要认人
  aiActions          AiAction[]
  /// 这个账号上传的自建菜谱（F1-12）
  recipes            Recipe[]
  /// 这个账号传给 AI 的图片附件
  aiAttachments      AiAttachment[]
  /// 这个账号的口味与健康档案（M8 / F8-01、F8-02）
  tasteProfile       TasteProfile?
  /// 这个账号勾掉的采购条目（M7 / F7-03）
  shoppingChecks     ShoppingCheck[]
  /// 这个账号加到采购清单里的条目（M7 / F7-03）
  shoppingExtras     ShoppingExtra[]

  @@index([createdAt])
}

/// 一次性密码重置令牌：只存 sha256 摘要，用掉即标记 usedAt（不能重复使用）。
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// 家庭：一人创建，其他人凭六位邀请码加入（D-021）。
model Family {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(32)
  /// 六位邀请码，字符集去掉了易混的 I/O/0/1；长期有效，掌勺人可重置（重置即旧码失效）
  inviteCode     String          @unique @db.VarChar(8)
  /// 家庭级共享开关（F2-07）：关掉后家庭成员之间不互相可见（M3 起由各功能读取）
  shared         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        FamilyMember[]
  /// 这一家的点单（M3）
  mealOrders     MealOrder[]
  /// 这一家的打卡照片（M9 / F9-03）
  checkIns       CheckIn[]
  /// 这一家的常用组合（M4 / F4-04）
  combos         Combo[]
  /// 这一家的冰箱食材（M6 / F6-01）
  fridgeItems    FridgeItem[]
  /// 这一家自建的菜谱（F1-12）
  recipes        Recipe[]
  /// 这一家的 AI 写库记录（F16-10）
  aiActions      AiAction[]
  /// 这一家的 AI 附件（对话里的图片）
  aiAttachments  AiAttachment[]
  /// 这一家的采购清单勾选（M7 / F7-03）
  shoppingChecks ShoppingCheck[]
  /// 这一家自己往采购清单上加的条目（M7 / F7-03）
  shoppingExtras ShoppingExtra[]

  @@index([createdAt])
}

/// 家庭成员：角色三档（掌勺人/帮厨/吃货），能力由角色决定，不做按人覆盖（D-021）。
model FamilyMember {
  id       String     @id @default(cuid())
  familyId String
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     FamilyRole @default(EATER)
  joinedAt DateTime   @default(now())

  @@index([familyId])
}

enum FamilyRole {
  /// 掌勺人：家庭管理员，唯一（转让即换人）
  OWNER
  /// 帮厨：能改菜单、能确认做好、能点菜
  COOK
  /// 吃货：只能点菜
  EATER
}

/// 刷新令牌：只存 sha256 摘要（泄库也无法直接使用），支持过期与吊销（退出登录即吊销）。
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// JSON collections retain ordered ingredients, nested step text and source notes.
/// origin and sourceKey isolate imported records from future user-created recipes.
model Recipe {
  id                String      @id
  name              String
  // image 始终是**源站的原始图片地址**，由导入器维护；
  // 自托管副本的信息写在下面 image* 三个字段里（由 mirror-images 脚本维护）。
  // 分开存的原因：① 保留溯源与"重新下载"能力；② 避免重新导入时把镜像地址误判成"内容变了"而覆盖。
  image             String?     @db.VarChar(512)
  // 自托管对象在存储桶里的 key（按内容 sha256 命名，同一张图被多道菜引用时只存一份）
  imageKey          String?     @db.VarChar(512)
  // 图片字节的 sha256：跨次运行去重，判断是否已备份过
  imageHash         String?     @db.VarChar(64)
  imageStoredAt     DateTime?
  category          String
  cuisine           String
  aliases           Json
  tags              Json
  calories          Float?
  caloriesEstimated Boolean     @default(false)
  spiciness         Int         @default(0)
  ingredients       Json
  steps             Json
  notes             Json
  tools             Json
  videoUrl          String?     @db.VarChar(512)
  source            Json
  origin            String      @default("user")
  sourceKey         String?     @unique
  sourcePath        String?     @db.VarChar(512)
  /// 自建菜谱归属的家庭（F1-11 / F1-12，用户 2026-10-13：「自己上传的要和极速 api 的区分下」）。
  /// **null = 全局菜谱库**——导入器从第三方源抓来的，谁都能看、谁都不能改（改了下次导入会对不上）。
  /// 有值 = 这个家自己上传的：只给自家人看（与冰箱、常用组合同一个口径），本家人可改可删。
  /// 不为导入的菜谱补一个"公共家庭"：null 本身就准确表达了"不属于任何一家"。
  familyId          String?
  family            Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁上传的（自建才有）。onDelete: SetNull——人走了菜谱留在家里，别把一家人做过的东西带走
  createdById       String?
  createdBy         User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // 以下两个字段会存长文本：MySQL 下 Prisma 默认映射为 VARCHAR(191)，
  // 不加 @db.Text 会在导入时抛 "Data too long"（searchText 拼了名称/别名/配料/标签，必然超长）
  rawMarkdown       String?     @db.Text
  searchText        String      @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  /// 被点过的菜（M3；菜谱删除时点单记录保留，见 OrderItem）
  orderItems        OrderItem[]
  /// 被收进常用组合的引用（M4 / F4-04；菜谱删除时那一组里的这条也跟着删）
  comboItems        ComboItem[]
  /// 被谁收藏了（M1 / F1-09；菜谱删除时收藏记录跟着删——菜都没了，收藏没有意义）
  favorites         Favorite[]

  @@index([category, cuisine])
  @@index([origin])
  /// 列表要按"全局库 + 我这个家"过滤，走这个索引
  @@index([familyId])
}

/// 收藏（M1 / F1-09）：**按人存**，不按家庭。
///
/// 为什么是"人"而不是"家庭"：收藏是"我想做什么/我爱吃这个"这种个人偏好，
/// 与点单（家庭协作）、组合（一家人的常用搭配）不是一回事——一家四口各收藏各的才合理。
/// 家庭共享开关（F2-07）也就与它无关：它管的是"家人的点单与照片互相可见"。
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// 同一个人对同一道菜只能有一条：收藏是"是/不是"，不是计数（重复点只会变成取消再收藏）
  @@unique([userId, recipeId])
  /// 列表按人取、按时间倒序（最近收藏的在前）
  @@index([userId, createdAt])
}

/// 一餐（F3-01/02/04）：**按「家庭 + 日期 + 餐次」聚合**，家人各自往里点菜，状态是整餐的（D-022）。
/// 一张卡 = 一个 MealOrder；mealKey 是它的稳定标识（家庭内唯一），前端用它做路由与流转。
model MealOrder {
  id            String      @id @default(cuid())
  familyId      String
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 就餐日期（只取日期部分，本地时区由写入方归一）
  mealDate      DateTime    @db.Date
  meal          MealSlot
  status        OrderStatus @default(PENDING)
  /// 就餐人数（M4 / F4-05）：含没点菜只吃饭的家人，由掌勺人/帮厨设定；null = 还没定
  dinerCount    Int?
  /// 谁把这一版菜单定下来的（M4 / F4-05 的"确认留痕"）+ 什么时候；null = 还在收集中。
  /// 取消、或取消后重新加菜（整餐拉回 PENDING）时清空：上一版菜单不算数了，"谁定的"也没意义。
  /// User 侧用 SetNull：人退出家庭/注销不该让这一餐查不出来。
  confirmedById String?
  confirmedBy   User?       @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  /// 谁把这一餐标成「做好了」（M10 / F10-02 的通知要认这个，2026-10-15）+ 什么时候。
  ///
  /// 为什么不能拿 `updatedAt` 顶替：它**任何**字段一改就动（改人数、上传成品照都算），
  /// 而通知要回答的是"这一餐**刚**做好"——拿一个会乱动的时间戳当判据，误报是必然的。
  /// 与上面那对 `confirmedById/At` 对称：一个是"谁定的菜单"，一个是"谁做好的"。
  ///
  /// 「做好了」是终态（不能再加菜、不能取消），所以这两个值一旦写上就不会变；
  /// 仍然按 `confirmStampFor` 的同一形状给了 clear 分支——状态机哪天允许退回去，这里不用再想一遍。
  doneById      String?
  doneBy        User?       @relation("MealDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  doneAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  /// 这一餐的成品照（M9 / F9-08）
  checkIns      CheckIn[]

  /// 同一餐只有一条：并发的两次点菜不会各建一餐
  @@unique([familyId, mealDate, meal])
  /// 列表按日期倒序 + 餐次排序取，加索引
  @@index([familyId, mealDate])
}

/// 点单里的一道菜（F3-05 备注随菜走）。同一个人可以把同一道菜点多次（份数）、不同人可各点各的。
model OrderItem {
  id          String    @id @default(cuid())
  mealOrderId String
  mealOrder   MealOrder @relation(fields: [mealOrderId], references: [id], onDelete: Cascade)
  /// 点菜人
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联菜谱（菜谱被删时保留点单记录，所以可空 + 冗余菜名）
  recipeId    String?
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// 冗余菜名与图片：菜谱日后改名/删图不影响历史点单卡（也避免列表查询为了显示再连一次菜谱表）
  recipeName  String    @db.VarChar(120)
  recipeImage String?   @db.VarChar(512)
  /// 这一份的备注，如"小满那份不要辣"
  note        String?   @db.VarChar(120)
  createdAt   DateTime  @default(now())

  @@index([mealOrderId])
  @@index([userId])
}

enum MealSlot {
  /// 午餐
  LUNCH
  /// 晚餐
  DINNER
}

/// 点单状态机（D-022）：待确认 → 已安排 → 准备中 → 已做好；CANCELED 是终态。
/// 不允许跳级、不允许从终态回退——要重做就「再点一次」新建一餐。
enum OrderStatus {
  PENDING
  PLANNED
  COOKING
  DONE
  CANCELED
}

/// 打卡照片（M9 / F9-03、F9-07、F9-08；口径见 D-023）。
///
/// 一张照片一条记录：家庭成员都能传，同家庭一起看；照片本体存**私有桶**（不在这个表里），
/// 这里只存对象 key 与内容哈希，对外通过签名短链（API 流式读出）访问。
/// 可选挂在某一餐上（"这顿做好了"拍的成品照）；独立打卡则 mealOrderId 为空。
model CheckIn {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 上传者
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 可选：挂在"已做好"的那一餐上（F9-08）。这一餐被删时打卡保留（照片仍是人的记录）
  mealOrderId String?
  mealOrder   MealOrder? @relation(fields: [mealOrderId], references: [id], onDelete: SetNull)
  /// 私有桶里的对象 key（按内容 sha256 命名，同一张图只存一份）
  imageKey    String     @db.VarChar(512)
  /// 图片字节的 sha256
  imageHash   String     @db.VarChar(64)
  /// 打卡日（只取日期部分，按服务器本地时区的日历日归一）——热力图按它聚合
  checkDate   DateTime   @db.Date
  /// 一句交代，如"给小满做的生日面"
  note        String?    @db.VarChar(60)
  createdAt   DateTime   @default(now())

  /// 家庭墙按时间倒序取 + 热力图按日期聚合
  @@index([familyId, createdAt])
  @@index([familyId, checkDate])
  @@index([userId, checkDate])
  @@index([mealOrderId])
}

/// 常用组合（M4 / F4-04）：把常一起点的一组菜存成一个"套餐"，一键整组加进某一餐。
///
/// 为什么要有：家庭点菜是**成组**发生的（"快手三菜一汤"、"周末火锅"），
/// 每次都逐个翻菜谱再加，五六道菜就是五六次搜索+点击。存成组合之后一次点完。
///
/// 归属是**家庭**而不是个人：组合是家里人共用的（妈妈组的"周末硬菜"爸爸也能用），
/// 与冰箱、菜单同一层可见性；创建者记录下来，用于"谁加的"与后续按人清理。
model Combo {
  id          String      @id @default(cuid())
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 组这个组合的人（记录，不限制别人使用）
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// 组合名，如「快手三菜一汤」
  name        String      @db.VarChar(24)
  /// 一句话说明（可空），如「工作日的晚上」
  note        String?     @db.VarChar(60)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       ComboItem[]

  /// 同一家不重名：重名会让"一键加入"变成一道选择题，而组合本身就该是记得住的那几个
  @@unique([familyId, name])
  @@index([familyId, createdAt])
}

/// 组合里的一道菜。
///
/// 两道菜同一个组合里**只存一条**（`@@unique([comboId, recipeId])`）：重复加同一道菜
/// 没有意义（点单里同一道菜多人点才叠加份数），去重放在库层比放在应用层可靠。
model ComboItem {
  id       String @id @default(cuid())
  comboId  String
  combo    Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  recipeId String
  /// 菜谱被删时**整组里的这一条也不留**（组合是"能一键加进去的菜"，菜没了这条就是空指针）
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// 组内的展示顺序（按加入顺序）
  position Int    @default(0)

  @@unique([comboId, recipeId])
  @@index([comboId, position])
}

/// 冰箱里的一件食材（M6 / F6-01）。形态见 D-049：录入 = 手动 + 拍照（拍照那半待多模态模型）。
///
/// 为什么不与"采购清单"共用一张表：两者是**不同时刻的同一件事**——采购清单是"要去买什么"
/// （从菜单推出来的建议，会随菜单变），冰箱是"家里确实有什么"（人放进去的事实，只由人改）。
/// 混在一张表里，菜单一变就会把用户确认过的库存改掉，那是数据损坏而不是同步。
///
/// 归属是**家庭**（家里人共用一台冰箱），记 `addedById` 用于"谁放的"与后续按人清理。
/// 四区（F6-04）与保质期（F6-05）就是 F17-02「3D 冰箱预览」要的数据底座（见 D-049）。
model FridgeItem {
  id        String @id @default(cuid())
  familyId  String
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 放进去的人（拍照识别批量入库时也是它）
  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id], onDelete: Cascade)

  /// 食材名（如"鸡蛋"）。同一家里同名同区只留一条——见下面的唯一约束
  name      String    @db.VarChar(40)
  /// 数量与单位。可空：很多食材就是"有一点"，逼人填数字会让人干脆不录
  amount    String?   @db.VarChar(24)
  /// 存放位置（F6-04）。用四档固定值而不是自由文本：3D 预览要按它摆位（F17-02）
  zone      String    @default("冷藏") @db.VarChar(12)
  /// 保质期（F6-05）。**只到日**，且可空——不是每样食材都有明确保质期
  expiresOn DateTime? @db.Date
  /// 一句备注（"给奶奶买的"、"开口了要先吃"）
  note      String?   @db.VarChar(60)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 同一家庭、同一存放区里**同名只留一条**：冰箱里"两盒鸡蛋"应该是改数量（或写备注），
  /// 而不是两条同名记录——否则概览的件数会虚高、按名匹配做菜（F5-04）也要去重
  @@unique([familyId, zone, name])
  /// 列表按分区取、按保质期排（今日先吃要能走索引）
  @@index([familyId, zone])
  @@index([familyId, expiresOn])
}

/// 冰箱的"存放区"是固定四档（F6-04），不建表：它是由 3D 预览的摆位与人的直觉共同定死的，
/// 允许自定义会让"这盒牛奶在哪儿"变成一道需要回忆的选择题。

/// AI 助手写库的记录（F16-10 / D-052；用户 2026-10-13 拍板"加表"）。
///
/// 为什么值得单独一张表（而不是像最初设想的"撤销所需的值随回执卡回前端就行"）：
/// 撤销要**由服务端核对**才敢做——A 档允许 AI 直接写库，那"撤"就必须经得起三种意外：
/// ① 那条已经被用户自己改过（撤销会覆盖掉他的改动）；② 那条已经被删了（撤销是在凭空造数据）；
/// ③ 会话里回执卡还挂着，但服务端早就不该接受了。没有记录表，这三件事一件都判不了。
///
/// **不存旧值的完整快照**（虽然审计上更完备）：存了就等于在库里留一份"用户数据的影子副本"，
/// 而这块数据是私人的。改为存**反向动作**——撤销需要的信息在写的那一刻就已经知道了，
/// 把它记成"再执行一次就能回到原样"的动作，不需要把整行复制过来。
model AiAction {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁让 AI 干的（撤销要认人：别人不能撤你的）
  actorId  String
  actor    User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// 干了什么。v1 只有 `fridge.create` / `fridge.update` / `fridge.remove`（A 档）
  kind    String @db.VarChar(32)
  /// 人话摘要（回执卡上那句"鸡蛋 · 一盒 · 冷藏"直接用它，前端不必自己拼）
  summary String @db.VarChar(120)

  /// 撤销所需的反向动作。形状由 `kind` 决定，见 ai-action.rules 的 undoPlan——
  /// **不在这里做 JSON 的语义校验**（那是 rules 的活），这里只存
  undoData Json

  /// 撤销的痕迹。三态用一个可空时间戳表达，不另立枚举：
  /// `null` = 还能撤；有值 = 已经撤过（再撤就拒绝，而不是撤两次）
  undoneAt DateTime?
  /// 结果对象（如冰箱那条的 id）。**不做外键**：撤销会把那个对象删掉，
  /// 外键会让"已撤销"的记录连带消失——而它恰恰是要留下来证明撤过的
  targetId String?   @db.VarChar(40)

  createdAt DateTime @default(now())

  /// 撤销按"这一家最近几条"找，以及"这条是否已经撤过"的判定
  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
}

/// AI 助手的图片附件（F16-05 的一次落地；用户 2026-10-13：
/// 「ai助手那里也需要添加附件上传功能，会话中也要能展示图片，历史会话图片也得展示，不能丢失」）。
///
/// **为什么图片必须存服务端，而不是塞进前端那份 localStorage**：
/// 会话是整场落盘在前端的（见 `stores/ai-assistant-session`），但一张手机照片缩完也有几百 KB，
/// 而 localStorage 只有 5MB 左右——塞两张图就会写失败，**而且失败是静默的**：
/// 对话本身也存不进去了，用户下次打开发现整场对话没了。所以图片字节存对象存储，
/// 前端只留一个 id（几十字节），要显示时按需取（见 `GET /ai/attachments/:id/photo`）。
///
/// 放在**私有桶**（`MEDIA_S3_PRIVATE_BUCKET` 的 `ai/` 前缀下）：这些图是家里冰箱/厨房的照片，
/// 与打卡照片同一级别的私人内容，不能像菜谱图那样公开读。
model AiAttachment {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁传的。读取时按"同家庭"放行，但留这一列是为了额度控制与将来"只看自己传的"
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 私有桶里的对象 key（按内容 sha256 命名，同一张图重复上传只存一份）
  imageKey  String @db.VarChar(512)
  /// 图片字节的 sha256
  imageHash String @db.VarChar(64)
  /// 归一后的真实类型（`image/jpeg` / `image/png` / `image/webp`），发给定型接口时要带它
  mimeType  String @db.VarChar(32)
  /// 字节数。用来算"这个人一共占了多少"，不必去问对象存储
  bytes     Int

  createdAt DateTime @default(now())

  /// 取图按 id、额度按"这个人最近传了多少"
  @@index([familyId, createdAt])
  @@index([userId, createdAt])
}

/// 口味与健康档案（M8 / F8-01、F8-02）。
///
/// **成员级，一人一条，跟着人走**：这是"他吃不吃辣、对什么过敏"，不是这家的资产——
/// 所以这张表**刻意不存 familyId**。存了的话，人退出家庭再进另一个家时它就是脏的
/// （档案的归属其实由 `FamilyMember` 决定，全家的档案 = 这个家所有成员各自的档案，
/// 一次 join 就够，不需要冗余一列）。早期版本曾打算存，删掉是因为"多一列可以少一个 join"
/// 远不值"多一处会在换家庭后失准的数据"。
///
/// 四个字段都可空/可空数组：**空 = 还没说过**，与"说了没有"是两件事。
/// 过滤时只认填过的那些，界面上会明说"还有 N 人没写"（见 taste.rules 文件头 ③）。
model TasteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 能接受到哪一档辣（0 不吃辣 / 1 微辣 / 2 中辣 / 3 重辣）；null = 没说过（不限）
  spicyLevel Int?
  /// 口味偏好标签（清淡/少盐/偏甜…）。**只是给模型的偏好信号**，不做硬过滤——
  /// "少盐"在配料表里匹配"盐"会把几乎所有菜都排掉（见 taste.rules 文件头 ④）
  flavors    Json    @default("[]")
  /// 荤素倾向（无偏好/多吃素/全素）；null = 没说过。同样只作偏好，不硬拦
  /// （"多吃素"不是禁忌，硬拦会把他今天想吃的红烧肉也抽掉）
  diet       String? @db.VarChar(12)
  /// 过敏原（食材级的词，如"花生"）。**硬拦**：推荐里排除、点菜时明确警告
  allergies  Json    @default("[]")
  /// 忌口/不爱吃（同样是食材级的词）。软提醒：推荐里排除、点菜时提示
  dislikes   Json    @default("[]")
  /// 一句备注（"医生说要少盐"这种没法结构化但很要紧的话）
  note       String? @db.VarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 采购清单的勾选状态（M7 / F7-03）。
///
/// 为什么值得建表：勾选原来是组件里的 `useState`，页面自己写着"只记在这一屏，刷新就没了"。
/// 而真实用法是**拿着手机在超市里一样一样划掉**——中途切个 App、回个消息，划掉的全没了。
///
/// **按 `name` 存，不按"清单条目 id"**：清单是每次请求从菜单现算出来的（F7-01），
/// 它没有稳定 id；而"这袋盐我买了"这件事与"哪份菜单要多少盐"无关。
/// 顺带的好处：清单里没有的名字**天然被忽略**（不必清理），
/// 而自加条目（`ShoppingExtra`）与菜单推出来的条目**共用同一套勾选**（都是清单上的一行）。
///
/// **有保质期**（`checkedAt`，服务端按 `SHOPPING_CHECK_TTL_DAYS` 判过期）：
/// 上周勾掉的"葱"如果这周还亮着勾，用户会以为自己买过了——**宁可让他重新勾一次，
/// 也不要拿上周的勾当这周的**。过期行在每次读取时顺手删掉（不留垃圾）。
model ShoppingCheck {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 勾掉的那样东西（食材名，与清单上的 `name` 同一口径）
  name        String   @db.VarChar(40)
  /// 谁在超市里划掉的（共享关掉时只认自己勾的，与清单可见性同一套闸门）
  checkedById String
  checkedBy   User     @relation(fields: [checkedById], references: [id], onDelete: Cascade)
  checkedAt   DateTime @default(now())

  /// 同一家、同一样只留一条：勾是一个状态，不是一串事件
  @@unique([familyId, name])
  @@index([familyId, checkedAt])
}

/// 用户自己往采购清单上加的条目（M7 / F7-03「增减条目」）。
///
/// 清单是从菜单推出来的，推不出来的东西不代表不用买：垃圾袋、洗洁精、
/// 孩子明天要带的水果——买菜路上想起来的东西没有菜谱。
/// 不给这个入口，用户就得为了记一样东西去编一道菜（或者干脆忘掉）。
///
/// **只存用户加的那部分**：菜单推出来的条目仍然每次现算（改了菜单就该跟着变），
/// 两者在接口层合成一张清单。所以这张表**不需要**跟随菜单变动做同步。
model ShoppingExtra {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(40)
  /// 要买多少（自由文本，可空——与冰箱那侧同一口径：逼人填数字会让人干脆不记）
  amount    String?  @db.VarChar(24)
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// 同一家同名只留一条（与冰箱同名同区只留一条同一规矩：两条同名会让人不知道怎么算）
  @@unique([familyId, name])
  @@index([familyId, createdAt])
}

/// 消息提醒的**四个开关**（M10 / F10-04，2026-10-15）。
///
/// 为什么是一张自己的表，而不是往 `TasteProfile` 上加几个字段：那两件事没有关系。
/// 口味是"家里吃什么"，这里是"什么该打扰我"——合表会让两边都得读一份自己不需要的数据，
/// 而且以后任一边加字段都要动同一行。
///
/// **四个开关各自独立**（`F10-01` 菜单安排 / `F10-02` 饭已做好 / `F10-03` 快过期 / 备菜）：
/// 一个总开关看着简洁，但用户真正想关的往往是**其中一个**——"饭好了要告诉我、
/// 别天天催我备菜"是很常见的组合。关掉一个不影响其余三个。
///
/// **已读状态不在这张表上**——它逐条记在 `NotificationEvent.readAt` 里
/// （用户 2026-10-15：「需要真的已读时才清」；按"推进水位线"设计过一版，被这句话否掉了）。
/// 这里**只存"什么该打扰我"**。
///
/// 一行不给（用户从没打开过通知中心 / 从没改过开关）时按**默认全开**处理，
/// 这是"没反对"而不是"同意过"——所以界面上那四个开关必须如实展示当前生效值。
model NotificationPref {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * 这里**只有四个开关**——"已读"不在这张表上，而是**逐条**记在 `NotificationEvent.readAt` 上。
   * 用户 2026-10-15 把这件事说得很准：「需要**真的已读**时才清」「通知那边点进去才清除」。
   * 所以判据不是"他进过哪个区域"（那样只要点一下底栏，他没看过的那些也跟着灭了——
   * 红点最坏的失败方式就是说谎），而是"这一条他有没有点开过"。
   */

  /// F10-01 菜单安排：某一天某一餐的菜单定下来了
  mealPlan Boolean @default(true)
  /// F10-02 饭已做好：我点过菜的那一餐做好了
  mealDone Boolean @default(true)
  /// F10-03 之一：冰箱里有东西快过期 / 已经过期
  expiry   Boolean @default(true)
  /// F10-03 之二：接下来几天有餐次还空着（备菜提醒）
  prep     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 通知的事件日志（M10，2026-10-15；用户要求"同一个账号换设备了也需要都留存"）。
///
/// ## 为什么有了"现状看板"还要这张表
///
/// 看板（`GET /notifications` 里现算的那些）回答的是"**现在**家里有什么事"，
/// 它有几条**刻意的自我清理**：那一餐被取消，「菜单定下来了」那条就没了；超过 30 天的餐次不进列表。
/// 那是看板该有的样子（它永远等于事实），但它**不是历史**——
/// 用户要的是"我过去收到过哪些通知，换设备也要都还在"。
///
/// 两者是**不同的东西**，不违反"同一个事实只存一份"：
/// - 看板说的是"这一餐现在是什么状态"（事实的唯一来源仍是 `MealOrder`）；
/// - 日志说的是"**某时刻发生过一件事，并且通知了谁**"——这是一件**它自己的**事实，
///   不会因为那一餐后来被取消就不再成立（它就是发生过）。
///
/// ## 谁写、什么时候写
///
/// - **有明确时刻的事件**（菜单定下来、饭做好了）：在**状态变更的那一刻**写，
///   与那次变更同一个请求里（见 `NotificationsService.recordMealEvent`）；
/// - **状态型的提醒**（快过期、该备菜）没有"发生的那一刻"——它们是"现在这个状态"。
///   所以按天**懒补一条**（`expiry:<userId>:<日期>` 这种确定性 id + upsert，重复读不会写重）。
///   语义是诚实的："那天你第一次看到时，确实有东西快过期"——
///   哪怕你后来把那盒奶喝了，这句话在当时也是真的。
///
/// ## 为什么按账号存、不是按家庭存 + 已读表
///
/// 提醒是**给我的**（开关也按账号，用户 2026-10-15 选定）。一家最多 10 人，
/// 写入时扇出十行毫无压力，而"按家庭存 + 每人一张已读表"要多一次 join、
/// 且每个查询都得记得带上那层关系——换来的是省下几行数据，不划算。
model NotificationEvent {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 家庭（清库/排查时按家看；用户退出家庭后这些行仍留着——那是他自己的历史）
  familyId String

  /// 四类之一（`plan` / `done` / `expiry` / `prep`），与看板同一套 kind（前端共用一份图标表）
  kind   String  @db.VarChar(12)
  /// 标题与副标题：**当时**拼好存下来的那句
  ///
  /// 为什么不存"事实引用"、渲染时再拼：日志要能如实回放**当时那句话**。
  /// 存引用的话，那一道菜改了名、这一餐被取消了，回看历史时句子就跟着变了——
  /// 而那正是"历史"不该有的行为（见 `RUNBOOK.md` R-069 里那条反证）。
  title  String  @db.VarChar(120)
  body   String? @db.VarChar(200)
  /// 点进去看哪儿（当时定的去处）
  toPath String  @db.VarChar(64)

  /// 事件时刻（排序与保留策略都用它）
  at DateTime

  /// 这一条**什么时候被读过**（逐条，不是按区域一笔勾掉）
  ///
  /// 用户 2026-10-15：「需要**真的已读**时才清」「通知那边点进去才清除通知」
  /// —— 点开那一条（并跳到它指的地方）才算读过它；另有「一键已读」把当时那一批一起推平。
  /// null = 还没读过。底栏红点 = 这一区未读的**条数**。
  readAt DateTime?

  /// 幂等键：同一件事对同一个人只写一条
  ///
  /// 有明确时刻的事件用 `plan:<mealKey>:<userId>`；按天懒补的用 `expiry:<userId>:<日期>`。
  /// **不能只靠"读的时候查一下有没有"**：并发两次请求会各写一条（本项目在
  /// "并发的两次点菜各建一餐"上踩过，那次是靠唯一约束兜住的）。
  dedupeKey String @db.VarChar(160)

  createdAt DateTime @default(now())

  @@unique([dedupeKey])
  @@index([userId, at])
}

// 数据库：MySQL 8（本地与服务器统一走 Docker，见 docker-compose.yml）。历史 SQLite 迁移已归档到 history/。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 键值型元信息，M0 用来验证 Prisma 迁移与读写链路可用
model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// 账号（F2-01/02/03）：账号 + 密码登录，未登录不可使用（D-008）。
/// 密码只存 scrypt 派生结果，格式 `scrypt$N$r$p$salt$hash`（自描述，便于日后换参数或算法）。
/// 口味/忌口档案（M8）与家庭成员关系（F2-05）后续都挂在这个 id 上。
model User {
  id             String          @id @default(cuid())
  account        String          @unique @db.VarChar(64)
  nickname       String          @db.VarChar(32)
  /// emoji 头像（与手绘风一致，见 apps/mobile 的 me__avatar）
  avatar         String          @default("🐰") @db.VarChar(16)
  passwordHash   String          @db.VarChar(255)
  /// 找回密码用的邮箱。首版**不做验证**（不要求收信确认），只作为重置链接的收件地址。
  email          String?         @unique @db.VarChar(160)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  /// 首版一个账号同时只属于一个家庭（DB 层用唯一约束兜住，见 FamilyMember）
  membership     FamilyMember?
  /// 这个账号点过的菜（M3）
  orderItems     OrderItem[]
  /// 这个账号的打卡照片（M9 / F9-07）
  checkIns       CheckIn[]
  /// 这个账号组过的常用组合（M4 / F4-04）
  combos         Combo[]
  /// 这个账号定下来的餐（M4 / F4-05 的确认留痕）
  confirmedMeals MealOrder[]
  /// 这个账号收藏的菜（M1 / F1-09）
  favorites      Favorite[]
  /// 这个账号放进冰箱的食材（M6 / F6-01）
  fridgeItems    FridgeItem[]
  /// 这个账号让 AI 干过的写库动作（F16-10 / AI 助手）——撤销要认人
  aiActions      AiAction[]
  /// 这个账号上传的自建菜谱（F1-12）
  recipes        Recipe[]
  /// 这个账号传给 AI 的图片附件
  aiAttachments  AiAttachment[]

  @@index([createdAt])
}

/// 一次性密码重置令牌：只存 sha256 摘要，用掉即标记 usedAt（不能重复使用）。
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// 家庭：一人创建，其他人凭六位邀请码加入（D-021）。
model Family {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(32)
  /// 六位邀请码，字符集去掉了易混的 I/O/0/1；长期有效，掌勺人可重置（重置即旧码失效）
  inviteCode    String         @unique @db.VarChar(8)
  /// 家庭级共享开关（F2-07）：关掉后家庭成员之间不互相可见（M3 起由各功能读取）
  shared        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       FamilyMember[]
  /// 这一家的点单（M3）
  mealOrders    MealOrder[]
  /// 这一家的打卡照片（M9 / F9-03）
  checkIns      CheckIn[]
  /// 这一家的常用组合（M4 / F4-04）
  combos        Combo[]
  /// 这一家的冰箱食材（M6 / F6-01）
  fridgeItems   FridgeItem[]
  /// 这一家自建的菜谱（F1-12）
  recipes       Recipe[]
  /// 这一家的 AI 写库记录（F16-10）
  aiActions     AiAction[]
  /// 这一家的 AI 附件（对话里的图片）
  aiAttachments AiAttachment[]

  @@index([createdAt])
}

/// 家庭成员：角色三档（掌勺人/帮厨/吃货），能力由角色决定，不做按人覆盖（D-021）。
model FamilyMember {
  id       String     @id @default(cuid())
  familyId String
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     FamilyRole @default(EATER)
  joinedAt DateTime   @default(now())

  @@index([familyId])
}

enum FamilyRole {
  /// 掌勺人：家庭管理员，唯一（转让即换人）
  OWNER
  /// 帮厨：能改菜单、能确认做好、能点菜
  COOK
  /// 吃货：只能点菜
  EATER
}

/// 刷新令牌：只存 sha256 摘要（泄库也无法直接使用），支持过期与吊销（退出登录即吊销）。
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// JSON collections retain ordered ingredients, nested step text and source notes.
/// origin and sourceKey isolate imported records from future user-created recipes.
model Recipe {
  id                String      @id
  name              String
  // image 始终是**源站的原始图片地址**，由导入器维护；
  // 自托管副本的信息写在下面 image* 三个字段里（由 mirror-images 脚本维护）。
  // 分开存的原因：① 保留溯源与"重新下载"能力；② 避免重新导入时把镜像地址误判成"内容变了"而覆盖。
  image             String?     @db.VarChar(512)
  // 自托管对象在存储桶里的 key（按内容 sha256 命名，同一张图被多道菜引用时只存一份）
  imageKey          String?     @db.VarChar(512)
  // 图片字节的 sha256：跨次运行去重，判断是否已备份过
  imageHash         String?     @db.VarChar(64)
  imageStoredAt     DateTime?
  category          String
  cuisine           String
  aliases           Json
  tags              Json
  calories          Float?
  caloriesEstimated Boolean     @default(false)
  spiciness         Int         @default(0)
  ingredients       Json
  steps             Json
  notes             Json
  tools             Json
  videoUrl          String?     @db.VarChar(512)
  source            Json
  origin            String      @default("user")
  sourceKey         String?     @unique
  sourcePath        String?     @db.VarChar(512)
  /// 自建菜谱归属的家庭（F1-11 / F1-12，用户 2026-10-13：「自己上传的要和极速 api 的区分下」）。
  /// **null = 全局菜谱库**——导入器从第三方源抓来的，谁都能看、谁都不能改（改了下次导入会对不上）。
  /// 有值 = 这个家自己上传的：只给自家人看（与冰箱、常用组合同一个口径），本家人可改可删。
  /// 不为导入的菜谱补一个"公共家庭"：null 本身就准确表达了"不属于任何一家"。
  familyId          String?
  family            Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁上传的（自建才有）。onDelete: SetNull——人走了菜谱留在家里，别把一家人做过的东西带走
  createdById       String?
  createdBy         User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // 以下两个字段会存长文本：MySQL 下 Prisma 默认映射为 VARCHAR(191)，
  // 不加 @db.Text 会在导入时抛 "Data too long"（searchText 拼了名称/别名/配料/标签，必然超长）
  rawMarkdown       String?     @db.Text
  searchText        String      @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  /// 被点过的菜（M3；菜谱删除时点单记录保留，见 OrderItem）
  orderItems        OrderItem[]
  /// 被收进常用组合的引用（M4 / F4-04；菜谱删除时那一组里的这条也跟着删）
  comboItems        ComboItem[]
  /// 被谁收藏了（M1 / F1-09；菜谱删除时收藏记录跟着删——菜都没了，收藏没有意义）
  favorites         Favorite[]

  @@index([category, cuisine])
  @@index([origin])
  /// 列表要按"全局库 + 我这个家"过滤，走这个索引
  @@index([familyId])
}

/// 收藏（M1 / F1-09）：**按人存**，不按家庭。
///
/// 为什么是"人"而不是"家庭"：收藏是"我想做什么/我爱吃这个"这种个人偏好，
/// 与点单（家庭协作）、组合（一家人的常用搭配）不是一回事——一家四口各收藏各的才合理。
/// 家庭共享开关（F2-07）也就与它无关：它管的是"家人的点单与照片互相可见"。
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// 同一个人对同一道菜只能有一条：收藏是"是/不是"，不是计数（重复点只会变成取消再收藏）
  @@unique([userId, recipeId])
  /// 列表按人取、按时间倒序（最近收藏的在前）
  @@index([userId, createdAt])
}

/// 一餐（F3-01/02/04）：**按「家庭 + 日期 + 餐次」聚合**，家人各自往里点菜，状态是整餐的（D-022）。
/// 一张卡 = 一个 MealOrder；mealKey 是它的稳定标识（家庭内唯一），前端用它做路由与流转。
model MealOrder {
  id            String      @id @default(cuid())
  familyId      String
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 就餐日期（只取日期部分，本地时区由写入方归一）
  mealDate      DateTime    @db.Date
  meal          MealSlot
  status        OrderStatus @default(PENDING)
  /// 就餐人数（M4 / F4-05）：含没点菜只吃饭的家人，由掌勺人/帮厨设定；null = 还没定
  dinerCount    Int?
  /// 谁把这一版菜单定下来的（M4 / F4-05 的"确认留痕"）+ 什么时候；null = 还在收集中。
  /// 取消、或取消后重新加菜（整餐拉回 PENDING）时清空：上一版菜单不算数了，"谁定的"也没意义。
  /// User 侧用 SetNull：人退出家庭/注销不该让这一餐查不出来。
  confirmedById String?
  confirmedBy   User?       @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  /// 这一餐的成品照（M9 / F9-08）
  checkIns      CheckIn[]

  /// 同一餐只有一条：并发的两次点菜不会各建一餐
  @@unique([familyId, mealDate, meal])
  /// 列表按日期倒序 + 餐次排序取，加索引
  @@index([familyId, mealDate])
}

/// 点单里的一道菜（F3-05 备注随菜走）。同一个人可以把同一道菜点多次（份数）、不同人可各点各的。
model OrderItem {
  id          String    @id @default(cuid())
  mealOrderId String
  mealOrder   MealOrder @relation(fields: [mealOrderId], references: [id], onDelete: Cascade)
  /// 点菜人
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联菜谱（菜谱被删时保留点单记录，所以可空 + 冗余菜名）
  recipeId    String?
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// 冗余菜名与图片：菜谱日后改名/删图不影响历史点单卡（也避免列表查询为了显示再连一次菜谱表）
  recipeName  String    @db.VarChar(120)
  recipeImage String?   @db.VarChar(512)
  /// 这一份的备注，如"小满那份不要辣"
  note        String?   @db.VarChar(120)
  createdAt   DateTime  @default(now())

  @@index([mealOrderId])
  @@index([userId])
}

enum MealSlot {
  /// 午餐
  LUNCH
  /// 晚餐
  DINNER
}

/// 点单状态机（D-022）：待确认 → 已安排 → 准备中 → 已做好；CANCELED 是终态。
/// 不允许跳级、不允许从终态回退——要重做就「再点一次」新建一餐。
enum OrderStatus {
  PENDING
  PLANNED
  COOKING
  DONE
  CANCELED
}

/// 打卡照片（M9 / F9-03、F9-07、F9-08；口径见 D-023）。
///
/// 一张照片一条记录：家庭成员都能传，同家庭一起看；照片本体存**私有桶**（不在这个表里），
/// 这里只存对象 key 与内容哈希，对外通过签名短链（API 流式读出）访问。
/// 可选挂在某一餐上（"这顿做好了"拍的成品照）；独立打卡则 mealOrderId 为空。
model CheckIn {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 上传者
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 可选：挂在"已做好"的那一餐上（F9-08）。这一餐被删时打卡保留（照片仍是人的记录）
  mealOrderId String?
  mealOrder   MealOrder? @relation(fields: [mealOrderId], references: [id], onDelete: SetNull)
  /// 私有桶里的对象 key（按内容 sha256 命名，同一张图只存一份）
  imageKey    String     @db.VarChar(512)
  /// 图片字节的 sha256
  imageHash   String     @db.VarChar(64)
  /// 打卡日（只取日期部分，按服务器本地时区的日历日归一）——热力图按它聚合
  checkDate   DateTime   @db.Date
  /// 一句交代，如"给小满做的生日面"
  note        String?    @db.VarChar(60)
  createdAt   DateTime   @default(now())

  /// 家庭墙按时间倒序取 + 热力图按日期聚合
  @@index([familyId, createdAt])
  @@index([familyId, checkDate])
  @@index([userId, checkDate])
  @@index([mealOrderId])
}

/// 常用组合（M4 / F4-04）：把常一起点的一组菜存成一个"套餐"，一键整组加进某一餐。
///
/// 为什么要有：家庭点菜是**成组**发生的（"快手三菜一汤"、"周末火锅"），
/// 每次都逐个翻菜谱再加，五六道菜就是五六次搜索+点击。存成组合之后一次点完。
///
/// 归属是**家庭**而不是个人：组合是家里人共用的（妈妈组的"周末硬菜"爸爸也能用），
/// 与冰箱、菜单同一层可见性；创建者记录下来，用于"谁加的"与后续按人清理。
model Combo {
  id          String      @id @default(cuid())
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 组这个组合的人（记录，不限制别人使用）
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// 组合名，如「快手三菜一汤」
  name        String      @db.VarChar(24)
  /// 一句话说明（可空），如「工作日的晚上」
  note        String?     @db.VarChar(60)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       ComboItem[]

  /// 同一家不重名：重名会让"一键加入"变成一道选择题，而组合本身就该是记得住的那几个
  @@unique([familyId, name])
  @@index([familyId, createdAt])
}

/// 组合里的一道菜。
///
/// 两道菜同一个组合里**只存一条**（`@@unique([comboId, recipeId])`）：重复加同一道菜
/// 没有意义（点单里同一道菜多人点才叠加份数），去重放在库层比放在应用层可靠。
model ComboItem {
  id       String @id @default(cuid())
  comboId  String
  combo    Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  recipeId String
  /// 菜谱被删时**整组里的这一条也不留**（组合是"能一键加进去的菜"，菜没了这条就是空指针）
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// 组内的展示顺序（按加入顺序）
  position Int    @default(0)

  @@unique([comboId, recipeId])
  @@index([comboId, position])
}

/// 冰箱里的一件食材（M6 / F6-01）。形态见 D-049：录入 = 手动 + 拍照（拍照那半待多模态模型）。
///
/// 为什么不与"采购清单"共用一张表：两者是**不同时刻的同一件事**——采购清单是"要去买什么"
/// （从菜单推出来的建议，会随菜单变），冰箱是"家里确实有什么"（人放进去的事实，只由人改）。
/// 混在一张表里，菜单一变就会把用户确认过的库存改掉，那是数据损坏而不是同步。
///
/// 归属是**家庭**（家里人共用一台冰箱），记 `addedById` 用于"谁放的"与后续按人清理。
/// 四区（F6-04）与保质期（F6-05）就是 F17-02「3D 冰箱预览」要的数据底座（见 D-049）。
model FridgeItem {
  id        String @id @default(cuid())
  familyId  String
  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 放进去的人（拍照识别批量入库时也是它）
  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id], onDelete: Cascade)

  /// 食材名（如"鸡蛋"）。同一家里同名同区只留一条——见下面的唯一约束
  name      String    @db.VarChar(40)
  /// 数量与单位。可空：很多食材就是"有一点"，逼人填数字会让人干脆不录
  amount    String?   @db.VarChar(24)
  /// 存放位置（F6-04）。用四档固定值而不是自由文本：3D 预览要按它摆位（F17-02）
  zone      String    @default("冷藏") @db.VarChar(12)
  /// 保质期（F6-05）。**只到日**，且可空——不是每样食材都有明确保质期
  expiresOn DateTime? @db.Date
  /// 一句备注（"给奶奶买的"、"开口了要先吃"）
  note      String?   @db.VarChar(60)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 同一家庭、同一存放区里**同名只留一条**：冰箱里"两盒鸡蛋"应该是改数量（或写备注），
  /// 而不是两条同名记录——否则概览的件数会虚高、按名匹配做菜（F5-04）也要去重
  @@unique([familyId, zone, name])
  /// 列表按分区取、按保质期排（今日先吃要能走索引）
  @@index([familyId, zone])
  @@index([familyId, expiresOn])
}

/// 冰箱的"存放区"是固定四档（F6-04），不建表：它是由 3D 预览的摆位与人的直觉共同定死的，
/// 允许自定义会让"这盒牛奶在哪儿"变成一道需要回忆的选择题。

/// AI 助手写库的记录（F16-10 / D-052；用户 2026-10-13 拍板"加表"）。
///
/// 为什么值得单独一张表（而不是像最初设想的"撤销所需的值随回执卡回前端就行"）：
/// 撤销要**由服务端核对**才敢做——A 档允许 AI 直接写库，那"撤"就必须经得起三种意外：
/// ① 那条已经被用户自己改过（撤销会覆盖掉他的改动）；② 那条已经被删了（撤销是在凭空造数据）；
/// ③ 会话里回执卡还挂着，但服务端早就不该接受了。没有记录表，这三件事一件都判不了。
///
/// **不存旧值的完整快照**（虽然审计上更完备）：存了就等于在库里留一份"用户数据的影子副本"，
/// 而这块数据是私人的。改为存**反向动作**——撤销需要的信息在写的那一刻就已经知道了，
/// 把它记成"再执行一次就能回到原样"的动作，不需要把整行复制过来。
model AiAction {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁让 AI 干的（撤销要认人：别人不能撤你的）
  actorId  String
  actor    User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// 干了什么。v1 只有 `fridge.create` / `fridge.update` / `fridge.remove`（A 档）
  kind    String @db.VarChar(32)
  /// 人话摘要（回执卡上那句"鸡蛋 · 一盒 · 冷藏"直接用它，前端不必自己拼）
  summary String @db.VarChar(120)

  /// 撤销所需的反向动作。形状由 `kind` 决定，见 ai-action.rules 的 undoPlan——
  /// **不在这里做 JSON 的语义校验**（那是 rules 的活），这里只存
  undoData Json

  /// 撤销的痕迹。三态用一个可空时间戳表达，不另立枚举：
  /// `null` = 还能撤；有值 = 已经撤过（再撤就拒绝，而不是撤两次）
  undoneAt DateTime?
  /// 结果对象（如冰箱那条的 id）。**不做外键**：撤销会把那个对象删掉，
  /// 外键会让"已撤销"的记录连带消失——而它恰恰是要留下来证明撤过的
  targetId String?   @db.VarChar(40)

  createdAt DateTime @default(now())

  /// 撤销按"这一家最近几条"找，以及"这条是否已经撤过"的判定
  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
}

/// AI 助手的图片附件（F16-05 的一次落地；用户 2026-10-13：
/// 「ai助手那里也需要添加附件上传功能，会话中也要能展示图片，历史会话图片也得展示，不能丢失」）。
///
/// **为什么图片必须存服务端，而不是塞进前端那份 localStorage**：
/// 会话是整场落盘在前端的（见 `stores/ai-assistant-session`），但一张手机照片缩完也有几百 KB，
/// 而 localStorage 只有 5MB 左右——塞两张图就会写失败，**而且失败是静默的**：
/// 对话本身也存不进去了，用户下次打开发现整场对话没了。所以图片字节存对象存储，
/// 前端只留一个 id（几十字节），要显示时按需取（见 `GET /ai/attachments/:id/photo`）。
///
/// 放在**私有桶**（`MEDIA_S3_PRIVATE_BUCKET` 的 `ai/` 前缀下）：这些图是家里冰箱/厨房的照片，
/// 与打卡照片同一级别的私人内容，不能像菜谱图那样公开读。
model AiAttachment {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 谁传的。读取时按"同家庭"放行，但留这一列是为了额度控制与将来"只看自己传的"
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 私有桶里的对象 key（按内容 sha256 命名，同一张图重复上传只存一份）
  imageKey  String @db.VarChar(512)
  /// 图片字节的 sha256
  imageHash String @db.VarChar(64)
  /// 归一后的真实类型（`image/jpeg` / `image/png` / `image/webp`），发给定型接口时要带它
  mimeType  String @db.VarChar(32)
  /// 字节数。用来算"这个人一共占了多少"，不必去问对象存储
  bytes     Int

  createdAt DateTime @default(now())

  /// 取图按 id、额度按"这个人最近传了多少"
  @@index([familyId, createdAt])
  @@index([userId, createdAt])
}

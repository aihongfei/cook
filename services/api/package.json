{
  "name": "@yushan/api",
  "private": true,
  "version": "0.1.0",
  "description": "御膳私房菜 · 后端 API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "fetch:recipes": "ts-node src/scripts/fetch-recipes.ts",
    "seed:recipes": "ts-node src/scripts/seed-recipes.ts",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/tests/*.test.js",
    "test:http": "node scripts/verify-recipes-http.cjs",
    "import:recipes": "ts-node src/scripts/import-recipes.ts",
    "normalize:names": "ts-node src/scripts/normalize-names.ts",
    "mirror:images": "ts-node src/scripts/mirror-images.ts",
    "test:http:auth": "node scripts/verify-auth-http.cjs",
    "test:http:family": "node scripts/verify-family-http.cjs",
    "test:http:orders": "node scripts/verify-orders-http.cjs",
    "test:http:combos": "node scripts/verify-combos-http.cjs",
    "test:http:checkins": "node scripts/verify-checkins-http.cjs",
    "test:http:ai": "node scripts/verify-ai-http.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}

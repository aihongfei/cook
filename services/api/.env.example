# 后端环境变量
# 复制为 .env 后按需修改；.env 不入库。

# 数据库：MySQL 8。
# - 本机开发（后端跑在宿主机、MySQL 跑在容器）：用 127.0.0.1
# - Docker 部署（api 也在容器里）：由 docker-compose.yml 覆盖为服务名 mysql，无需手改这里
DATABASE_URL="mysql://cook:change_me@127.0.0.1:3306/cook"

# 服务端口（浏览器直连与 nginx 代理都用它）
PORT=3000

# 监听地址：本机开发只绑回环；容器内由 compose 覆盖为 0.0.0.0
HOST=127.0.0.1

# 允许的前端来源（逗号分隔）：本机 Vite 开发服务器（前端不进 Docker）
CORS_ORIGIN=http://127.0.0.1:5173

# ---- 登录与令牌（F2-02）----
# 至少 32 个字符，且**不能有默认值兜底**：缺失时服务会拒绝启动，避免误用弱密钥。
# 生成：openssl rand -base64 48
JWT_SECRET=
# access token 有效期（秒），默认 2 小时；refresh token 固定 30 天
JWT_ACCESS_TTL_SECONDS=7200

# ---- 菜谱图片自托管（MinIO 对象存储）----
# 图片从第三方图床备份到这里（`pnpm run mirror:images`），此后前端只读自己的图。
# 密钥与根 .env 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 保持一致（本地开发用同一套）；
# 代码走标准 S3 协议，换成阿里云 OSS / 腾讯云 COS / AWS S3 只需改这几个变量。
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=cook-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
# 接口返回图片时拼的对外前缀：**必须是浏览器能访问到的地址**（服务器部署时换成域名或公网 IP）
MEDIA_BASE_URL=http://127.0.0.1:9000/cook-media
# 打卡照片的私有桶（M9 / D-023）：**不设公开读策略**，只经签名接口按家庭成员校验后读取。
# 容器部署时 docker-compose.yml 会把 MEDIA_S3_ENDPOINT 覆盖为 http://minio:9000（服务名）。
MEDIA_S3_PRIVATE_BUCKET=cook-checkins

# ---- 外部菜谱数据源（按需填写；密钥不入库、不写进文档、不贴进对话）----
# 极速数据 · 菜谱大全（当前主力源）：https://www.jisuapi.com 后台取 appkey
# 注意：注册后还需在后台「申请开通」菜谱接口，否则调用返回 status=103 APPKEY无请求此数据权限
JISU_APP_KEY=
JISU_APP_SECRET=
# 聚美智数 · 菜谱大全（补充源，实测无图）：后台获取 appId 与 appSecret
# （接口未开通会返回 code 601、余额不足返回 603）
JUMDATA_APP_ID=
JUMDATA_APP_SECRET=
# 聚合数据（当前因价格搁置，接入时再填）
JUHE_COOK_KEY=
